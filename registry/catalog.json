  "items": [
    {
      "name": "neumorphism-ui",
      "title": "Neumorphism UI",
      "description": "The light and dark design tokens for the Neumorphism UI registry.",
      "type": "registry:base",
      "extends": "none",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "rsc": true,
        "tsx": true,
        "tailwind": {
          "baseColor": "neutral",
          "css": "app/globals.css"
        },
        "aliases": {
          "components": "@/components",
          "utils": "@/lib/utils",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks"
        }
      },
      "registryDependencies": [
        "@neumorphism-ui/utils"
      ],
      "dependencies": [
        "pretendard@1.3.9"
      ]
    },
    {
      "name": "utils",
      "title": "Class name utility",
      "description": "A Tailwind-aware class name utility that resolves conflicting utilities.",
