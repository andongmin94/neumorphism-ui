{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "extends": "none",
  "name": "neumorphism-ui",
  "title": "Neumorphism UI",
  "description": "The light and dark design tokens for the Neumorphism UI registry.",
  "dependencies": [
    "@base-ui/react"
  ],
  "registryDependencies": [
    "@neumorphism-ui/utils"
  ],
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "calc(var(--radius) - 2px)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) + 4px)",
      "shadow-neu-raised": "var(--neu-shadow-raised)",
      "shadow-neu-raised-sm": "var(--neu-shadow-raised-sm)",
      "shadow-neu-inset": "var(--neu-shadow-inset)",
      "shadow-neu-primary": "var(--neu-shadow-primary)"
    },
    "light": {
      "background": "#e5ebf1",
      "foreground": "#172033",
      "card": "#e9eef4",
      "card-foreground": "#172033",
      "popover": "#eef3f8",
      "popover-foreground": "#172033",
      "primary": "#1267f4",
      "primary-foreground": "#ffffff",
      "secondary": "#dfe6ee",
      "secondary-foreground": "#233047",
      "muted": "#dfe6ee",
      "muted-foreground": "#566478",
      "accent": "#e3eaf2",
      "accent-foreground": "#1267f4",
      "destructive": "#b92e43",
      "success": "#0a9b78",
      "border": "rgb(83 99 123 / 0.18)",
      "input": "rgb(83 99 123 / 0.16)",
      "ring": "#1267f4",
      "radius": "18px",
      "neu-surface": "#e9eef4",
      "neu-surface-soft": "#f3f6f9",
      "neu-surface-low": "#dbe2ea",
      "neu-edge": "rgb(255 255 255 / 0.72)",
      "neu-shadow-dark": "rgb(30 48 72 / 0.14)",
      "neu-shadow-light": "rgb(255 255 255 / 0.88)",
      "neu-shadow-raised": "6px 6px 15px var(--neu-shadow-dark), -6px -6px 15px var(--neu-shadow-light)",
      "neu-shadow-raised-sm": "2px 2px 6px var(--neu-shadow-dark), -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 94%, transparent)",
      "neu-shadow-inset": "inset 2px 2px 6px var(--neu-shadow-dark), inset -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 97%, transparent)",
      "neu-shadow-primary": "2px 3px 7px var(--neu-shadow-dark), -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 94%, transparent), inset 0 1px 0 color-mix(in srgb, var(--primary) 72%, white)",
      "neu-shadow-primary-inset": "inset 2px 2px 5px color-mix(in srgb, var(--primary) 68%, black), inset -2px -2px 5px color-mix(in srgb, var(--primary) 78%, white)",
      "neu-radius-control": "12px",
      "neu-radius-surface": "18px",
      "neu-duration": "180ms",
      "neu-overlay": "rgb(15 23 42 / 0.28)",
      "neu-shadow-inset-sm": "inset 1px 1px 3px var(--neu-shadow-dark), inset -1px -1px 3px var(--neu-shadow-light)",
      "neu-shadow-destructive-inset": "inset 2px 2px 5px color-mix(in srgb, var(--destructive) 68%, black), inset -2px -2px 5px color-mix(in srgb, var(--destructive) 78%, white)",
      "neu-radius-overlay": "calc(var(--neu-radius-surface) + 4px)"
    },
    "dark": {
      "background": "#151a22",
      "foreground": "#e9f0fa",
      "card": "#1b222c",
      "card-foreground": "#e9f0fa",
      "popover": "#1b222c",
      "popover-foreground": "#e9f0fa",
      "primary": "#5aa2ff",
      "primary-foreground": "#07111f",
      "secondary": "#202a36",
      "secondary-foreground": "#e9f0fa",
      "muted": "#202a36",
      "muted-foreground": "#8fa1b7",
      "accent": "#202a36",
      "accent-foreground": "#5aa2ff",
      "destructive": "#ff7685",
      "success": "#40d6ad",
      "border": "rgb(255 255 255 / 0.1)",
      "input": "rgb(255 255 255 / 0.12)",
      "ring": "#5aa2ff",
      "radius": "18px",
      "neu-surface": "#1b222c",
      "neu-surface-soft": "#242d39",
      "neu-surface-low": "#141922",
      "neu-edge": "rgb(255 255 255 / 0.07)",
      "neu-shadow-dark": "rgb(0 0 0 / 0.34)",
      "neu-shadow-light": "rgb(255 255 255 / 0.065)",
      "neu-shadow-raised": "6px 6px 15px var(--neu-shadow-dark), -6px -6px 15px var(--neu-shadow-light)",
      "neu-shadow-raised-sm": "2px 2px 6px var(--neu-shadow-dark), -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 94%, transparent)",
      "neu-shadow-inset": "inset 2px 2px 6px var(--neu-shadow-dark), inset -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 97%, transparent)",
      "neu-shadow-primary": "2px 3px 7px var(--neu-shadow-dark), -2px -2px 6px color-mix(in srgb, var(--neu-shadow-light) 94%, transparent), inset 0 1px 0 color-mix(in srgb, var(--primary) 72%, white)",
      "neu-shadow-primary-inset": "inset 2px 2px 5px color-mix(in srgb, var(--primary) 68%, black), inset -2px -2px 5px color-mix(in srgb, var(--primary) 78%, white)",
      "neu-radius-control": "12px",
      "neu-radius-surface": "18px",
      "neu-duration": "180ms",
      "neu-overlay": "rgb(0 0 0 / 0.55)",
      "neu-shadow-inset-sm": "inset 1px 1px 3px var(--neu-shadow-dark), inset -1px -1px 3px var(--neu-shadow-light)",
      "neu-shadow-destructive-inset": "inset 2px 2px 5px color-mix(in srgb, var(--destructive) 68%, black), inset -2px -2px 5px color-mix(in srgb, var(--destructive) 78%, white)",
      "neu-radius-overlay": "calc(var(--neu-radius-surface) + 4px)"
    }
  },
  "css": {
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "body": {
        "@apply bg-background text-foreground": {},
        "background": "var(--background)"
      }
    },
    "@layer components": {
      ".neu-raised": {
        "background": "var(--neu-surface)",
        "box-shadow": "var(--neu-shadow-raised)"
      },
      ".neu-raised-sm": {
        "background": "var(--neu-surface)",
        "box-shadow": "var(--neu-shadow-raised-sm)"
      },
      ".neu-inset": {
        "background": "var(--neu-surface)",
        "box-shadow": "var(--neu-shadow-inset)"
      },
      ".neu-primary": {
        "background": "var(--primary)",
        "color": "var(--primary-foreground)",
        "box-shadow": "var(--neu-shadow-primary)"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      ".neu-raised, .neu-raised-sm, .neu-inset, .neu-primary": {
        "transition-duration": "0.01ms !important"
      }
    }
  },
  "type": "registry:base",
  "config": {
    "style": "base-nova",
    "rsc": true,
    "tsx": true,
    "tailwind": {
      "css": "app/globals.css",
      "baseColor": "neutral"
    },
    "iconLibrary": "lucide",
    "aliases": {
      "components": "@/components",
      "utils": "@/lib/utils",
      "ui": "@/components/ui",
      "lib": "@/lib",
      "hooks": "@/hooks"
    }
  }
}