{
  "name": "@neumorphism-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "fumapress dev",
    "build": "fumapress build",
    "start": "fumapress start",
    "predev": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "prebuild": "npm ci --prefix ../registry && npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "lint": "oxlint --no-error-on-unmatched-pattern --ignore-pattern src/registry src components i18n tests press.config.tsx vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "pretypecheck": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "verify:deployed": "node scripts/verify-deployed.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "@tanstack/react-table": "^8.21.3",
    "fumadocs-core": "16.15.7",
    "fumapress": "1.3.1",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.7",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "embla-carousel-react": "^8.6.0",
    "react-resizable-panels": "^4.12.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "6.0.2",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
