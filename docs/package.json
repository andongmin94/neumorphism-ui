{
  "name": "@neumorphism-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:ssr": "node --test tests/rendered-html.test.mjs",
    "predev": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "prebuild": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neumorphism-ui/registry": "file:../registry",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "@daypicker/react": "^10.0.1",
    "@tanstack/react-table": "^8.21.3",
    "pretendard": "1.3.9",
    "recharts": "3.10.1",
    "react-is": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vinext": "0.0.50",
    "vite": "^8.3.0",
    "wrangler": "4.92.0",
    "@playwright/test": "1.63.0",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
