{
  "name": "@neumorphism-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "fumapress dev",
    "build": "npm run build:site",
    "build:site": "node scripts/write-build-info.mjs && fumapress build",
    "start": "fumapress start",
    "predev": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "prebuild": "npm ci --prefix ../registry && npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "lint": "oxlint --no-error-on-unmatched-pattern --ignore-pattern src/registry src components i18n tests press.config.tsx vite.config.ts",
    "typecheck": "npm run typecheck:site",
    "typecheck:site": "tsc --noEmit",
    "test:browser": "playwright test",
    "pretypecheck": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "test:smoke": "playwright test --config=playwright.published.config.ts",
    "test:cloudflare": "playwright test --config=playwright.cloudflare.config.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "preview:cloudflare": "wrangler dev --local --port 4179",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@tanstack/react-table": "^9.3.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "fumapress": "1.6.2",
    "input-otp": "^1.5.0",
    "pretendard": "1.3.9",
    "pretendard-jp": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "4.151.3"
  }
}
