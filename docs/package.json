{
  "name": "@neumorphism-ui/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:ssr": "node --test tests/rendered-html.test.mjs",
    "predev": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "prebuild": "npm run build --prefix ../registry && npm run sync:docs --prefix ../registry",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@neumorphism-ui/registry": "file:../registry",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "@daypicker/react": "^10.0.0",
    "@tanstack/react-table": "^8.21.3",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.92.0",
    "@playwright/test": "^1.63.0"
  }
}
